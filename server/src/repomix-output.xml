import { Pool, type QueryResultRow } from "pg";

// Configura o acesso ao PostgreSQL com as variáveis do ambiente.
export const pool = new Pool({
  host: process.env.DB_HOST,
  port: Number(process.env.DB_PORT || 5432),
  user: process.env.DB_USER,
  password: process.env.DB_PASSWORD,
  database: process.env.DB_NAME,
});

pool.on("error", (error) => {
  console.error("Erro na conexão com o PostgreSQL:", error);
});

// Pool satisfaz esta interface; testes podem fornecer um substituto com query().
export interface Database {
  query<T extends QueryResultRow>(sql: string, values?: unknown[]): Promise<{ rows: T[] }>;
}
</file>

<file path="database/foreign-key-violation.ts">
// SQLSTATE 23503: violação de chave estrangeira no PostgreSQL.
export function isForeignKeyViolation(error: unknown): boolean {
  if (typeof error !== 'object' || error === null) {
    return false;
  }

  return 'code' in error && error.code === '23503';
}
</file>

<file path="database/unique-violation.ts">
// SQLSTATE 23505: violação de unicidade no PostgreSQL.
export function isUniqueViolation(error: unknown): boolean {
  if (typeof error !== 'object' || error === null) {
    return false;
  }

  return 'code' in error && error.code === '23505';
}
</file>

